{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StatusFile",
  "type": "object",
  "required": [
    "records"
  ],
  "properties": {
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/StatusRecord"
      }
    }
  },
  "$defs": {
    "StatusRecord": {
      "type": "object",
      "required": [
        "seatKey"
      ],
      "properties": {
        "seatKey": {
          "type": "string",
          "description": "floor|department|title"
        },
        "working": {
          "type": "boolean",
          "description": "true=桌前(工作) false=休息区(不工作)"
        },
        "state": {
          "type": "string",
          "enum": [
            "working",
            "away"
          ],
          "description": "可选替代 working"
        },
        "source": {
          "type": "string",
          "enum": [
            "mock",
            "live"
          ]
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "avatarUrl": {
          "type": [
            "string",
            "null"
          ],
          "description": "可选头像图 URL。有图用图（按 avatarShape 掩膜）。无图→形状填色+胶囊眼。无官方真源，仅为插槽。"
        },
        "avatarShape": {
          "type": "string",
          "enum": [
            "wedge",
            "teardrop",
            "hex",
            "blob",
            "cloud",
            "round",
            "square"
          ],
          "description": "头型：wedge=丸角右指三角/播放键，teardrop=水滴，hex=六边形，blob=圆，cloud=云朵/多瓣，round=同blob，square=方。缺省=blob（不再用桃色方块头）"
        },
        "avatarColor": {
          "type": "string",
          "description": "形状填色（CSS 颜色）；缺省用部门色"
        }
      },
      "description": "缺失/未知记录一律视为不工作；avatar* 字段可选，也可写在 org.json seat 上，status 记录值优先"
    }
  }
}
